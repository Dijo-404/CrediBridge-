# ── Dodo Payments ──────────────────────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_UNIVERSAL_PRODUCT_ID=

# ── Database & Cache ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credbridge
DATABASE_SSL=true
REDIS_URL=redis://localhost:6379

# ── Razorpay PayOut (real INR off-ramp) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYOUT_ACCOUNT=    # Your RazorpayX current account number
VENDOR_BANK_IFSC=ICIC0000001  # Default IFSC used when vendor hasn't specified one

# ── Solana / Anchor ─────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
SOLANA_PROGRAM_ID=          # Set after: bash scripts/deploy-program.sh
SOLANA_OPERATOR_KEYPAIR=    # JSON byte array: $(solana-keygen new --outfile /dev/stdout --no-bip39-passphrase 2>/dev/null)
USDC_MINT_ADDRESS=          # Devnet USDC mint (or Token-2022 mint from seed-devnet.ts)

# ── FX rate ─────────────────────────────────────────────────────────────────────
FX_API_URL=https://api.frankfurter.app/latest?from=USD&to=INR

# ── Runtime ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000   # Set to your Vercel URL in production
BACKEND_URL=http://localhost:3001    # Used by Next.js BFF routes
